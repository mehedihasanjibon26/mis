export function ui(lang: UILang, english: string): string {
  return lang === "bn" ? dictionary[english] ?? english : english;
}
export function digits(lang: UILang, value: string | number): string {
  const text = String(value);
  return lang === "bn" ? text.replace(/[0-9]/g, d => "০১২৩৪৫৬৭৮৯"[Number(d)]) : text;
}
export function numberUI(lang: UILang, n: number): string {
  return new Intl.NumberFormat(lang === "bn" ? "bn-BD" : "en-US").format(n);
}
export function dateUI(lang: UILang, value: string | number | Date): string {
  const date = value instanceof Date ? value : new Date(value);
  return Number.isNaN(date.getTime()) ? digits(lang,String(value)) : date.toLocaleString(lang === "bn" ? "bn-BD" : "en-GB");
}
